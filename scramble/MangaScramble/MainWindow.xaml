<Window x:Class="MangaScramble.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MangaDrive - Image Scramble Tool" Height="700" Width="900"
        WindowStartupLocation="CenterScreen" Background="#1a1a2e">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="🔀 MangaDrive Image Scramble Tool" 
                   FontSize="22" FontWeight="Bold" Foreground="#FF6B2C" Margin="0,0,0,20"/>

        <!-- Mode Selection -->
        <GroupBox Grid.Row="1" Header="Chế độ" Foreground="White" Margin="0,0,0,10" BorderBrush="#333">
            <StackPanel Orientation="Horizontal" Margin="10">
                <RadioButton x:Name="rbScramble" Content="Scramble (Xáo trộn)" 
                             IsChecked="True" Foreground="White" Margin="0,0,20,0"/>
                <RadioButton x:Name="rbUnscramble" Content="Unscramble (Khôi phục)" 
                             Foreground="White"/>
            </StackPanel>
        </GroupBox>

        <!-- Input/Output Folders -->
        <GroupBox Grid.Row="2" Header="Thư mục" Foreground="White" Margin="0,0,0,10" BorderBrush="#333">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Input:" 
                           Foreground="#ccc" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtInputFolder" 
                         Margin="0,0,8,8" Padding="6,4" Background="#2a2a3e" 
                         Foreground="White" BorderBrush="#444"/>
                <Button Grid.Row="0" Grid.Column="2" Content="Browse..." 
                        Click="BrowseInput_Click" Margin="0,0,0,8" Padding="10,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Output:" 
                           Foreground="#ccc" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtOutputFolder" 
                         Margin="0,0,8,0" Padding="6,4" Background="#2a2a3e" 
                         Foreground="White" BorderBrush="#444"/>
                <Button Grid.Row="1" Grid.Column="2" Content="Browse..." 
                        Click="BrowseOutput_Click" Padding="10,4"/>
            </Grid>
        </GroupBox>

        <!-- Scramble Settings -->
        <GroupBox Grid.Row="3" Header="Cài đặt Scramble" Foreground="White" Margin="0,0,0,10" BorderBrush="#333">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Master Key:" Foreground="#ccc"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" x:Name="txtKey" Padding="6,4"
                         Background="#2a2a3e" Foreground="White" BorderBrush="#444"
                         ToolTip="Master key gốc. Mỗi chapter xáo bằng masterKey:slug. Không lưu plaintext ra đĩa."/>

                <TextBlock Grid.Column="3" Text="Grid:" Foreground="#ccc"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="4" x:Name="cmbGrid" SelectedIndex="1"
                          Background="#2a2a3e" Foreground="Black">
                    <ComboBoxItem Content="3x3"/>
                    <ComboBoxItem Content="4x4"/>
                    <ComboBoxItem Content="5x5"/>
                    <ComboBoxItem Content="6x6"/>
                    <ComboBoxItem Content="8x8"/>
                </ComboBox>
            </Grid>
        </GroupBox>

        <!-- Preview -->
        <GroupBox Grid.Row="4" Header="Preview" Foreground="White" Margin="0,0,0,10" BorderBrush="#333">
            <Grid Margin="10" Height="200">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#111" CornerRadius="4">
                    <Grid>
                        <TextBlock Text="Original" Foreground="#666" HorizontalAlignment="Center" 
                                   VerticalAlignment="Top" Margin="0,4,0,0" FontSize="11"/>
                        <Image x:Name="imgOriginal" Stretch="Uniform" Margin="4,20,4,4"/>
                    </Grid>
                </Border>
                <TextBlock Grid.Column="1" Text="→" Foreground="#FF6B2C" FontSize="24" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border Grid.Column="2" Background="#111" CornerRadius="4">
                    <Grid>
                        <TextBlock Text="Scrambled" Foreground="#666" HorizontalAlignment="Center" 
                                   VerticalAlignment="Top" Margin="0,4,0,0" FontSize="11"/>
                        <Image x:Name="imgScrambled" Stretch="Uniform" Margin="4,20,4,4"/>
                    </Grid>
                </Border>
            </Grid>
        </GroupBox>

        <!-- Log -->
        <GroupBox Grid.Row="5" Header="Log" Foreground="White" BorderBrush="#333">
            <TextBox x:Name="txtLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                     Background="#111" Foreground="#0f0" FontFamily="Consolas" FontSize="11"
                     BorderThickness="0" Padding="8" TextWrapping="Wrap"/>
        </GroupBox>

        <!-- Actions -->
        <Grid Grid.Row="6" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="btnPreview" Content="👁 Preview" 
                    Click="Preview_Click" Padding="12,8" Margin="0,0,8,0"/>

            <ProgressBar Grid.Column="1" x:Name="progressBar" Height="24" 
                         Margin="8,0" Background="#333" Foreground="#FF6B2C"/>

            <TextBlock Grid.Column="1" x:Name="txtProgress" Foreground="White" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>

            <Button Grid.Column="2" x:Name="btnCancel" Content="✕ Hủy" 
                    Click="Cancel_Click" Padding="12,8" Margin="0,0,8,0" 
                    IsEnabled="False"/>

            <Button Grid.Column="3" x:Name="btnStart" Content="▶ Bắt đầu Scramble" 
                    Click="Start_Click" Style="{StaticResource PrimaryButton}" Padding="16,8"/>
        </Grid>
    </Grid>
</Window>
