<Window x:Class="MangaMetadataScraper.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MangaMetadataScraper.App"
        Title="Manga Metadata Scraper"
        MinWidth="1100" MinHeight="650"
        Width="1280" Height="780"
        Background="#1E1E2E">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <local:CountToVisibilityConverter x:Key="CountToVis"/>
        <local:NullToVisibilityConverter x:Key="NullToVis"/>
        <local:BoolToSearchImagesTextConverter x:Key="BoolToSearchImagesText"/>
        <local:BoolToSaveTextConverter x:Key="BoolToSaveText"/>

        <!-- Styles -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background"               Value="#313244"/>
            <Setter Property="Foreground"               Value="#CDD6F4"/>
            <Setter Property="CaretBrush"               Value="#CBA6F7"/>
            <Setter Property="BorderBrush"              Value="#45475A"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="10,7"/>
            <Setter Property="FontSize"                 Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"    Value="#CBA6F7"/>
            <Setter Property="Foreground"    Value="#1E1E2E"/>
            <Setter Property="FontWeight"    Value="Bold"/>
            <Setter Property="FontSize"      Value="13"/>
            <Setter Property="Padding"       Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D4BFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#45475A"/>
                                <Setter Property="Foreground" Value="#6C7086"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#F38BA8"/>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button">
            <Setter Property="Background"    Value="#A6E3A1"/>
            <Setter Property="Foreground"    Value="#1E1E2E"/>
            <Setter Property="FontWeight"    Value="Bold"/>
            <Setter Property="FontSize"      Value="13"/>
            <Setter Property="Padding"       Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B8F0B3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#45475A"/>
                                <Setter Property="Foreground" Value="#6C7086"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsBtn" TargetType="Button">
            <Setter Property="Background"    Value="#45475A"/>
            <Setter Property="Foreground"    Value="#CDD6F4"/>
            <Setter Property="FontWeight"    Value="Bold"/>
            <Setter Property="FontSize"      Value="13"/>
            <Setter Property="Padding"       Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#585B70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,2"/>
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="#CDD6F4"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ListBox item template -->
        <DataTemplate x:Key="SearchItemTemplate">
            <Border Background="#313244" CornerRadius="6"
                    Margin="0,0,0,4" Padding="8"
                    Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Thumbnail -->
                    <Border Grid.Column="0" CornerRadius="4" ClipToBounds="True"
                            Width="44" Height="62" VerticalAlignment="Top"
                            Background="#1E1E2E">
                        <Grid>
                            <TextBlock Text="..."
                                       Foreground="#585B70" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IsLoadingThumb, Converter={StaticResource BoolToVis}}"/>
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                   Visibility="{Binding IsLoadingThumb, Converter={StaticResource InverseBoolToVis}}"/>
                        </Grid>
                    </Border>

                    <!-- Info -->
                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   Foreground="#CDD6F4"
                                   FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SubTitle, Mode=OneWay}"
                                   Foreground="#A6ADC8"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,2"/>
                        <Border Background="{Binding SourceColor}"
                                CornerRadius="3" Padding="5,2"
                                HorizontalAlignment="Left" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Source}"
                                       Foreground="#1E1E2E"
                                       FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ListBox style — remove focus border -->
        <Style x:Key="ResultListBoxStyle" TargetType="ListBox">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding"     Value="0"/>
                        <Setter Property="Background"  Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#45475A"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#585B70"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Search bar + status -->
            <RowDefinition Height="*"/>     <!-- Main content -->
        </Grid.RowDefinitions>

        <!-- ══ Search Bar ════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Input row -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Style="{StaticResource InputStyle}"
                         Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,8,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="1"
                        Style="{StaticResource PrimaryBtn}"
                        Content="🔍 Search"
                        Command="{Binding SearchCommand}"
                        Margin="0,0,6,0"/>

                <Button Grid.Column="2"
                        Style="{StaticResource SaveBtn}"
                        Content="{Binding IsSaving, Converter={StaticResource BoolToSaveText}}"
                        Command="{Binding SaveMetadataCommand}"
                        Margin="0,0,6,0"
                        Visibility="{Binding HasMetadata, Converter={StaticResource BoolToVis}}"/>

                <Button Grid.Column="3"
                        Style="{StaticResource SettingsBtn}"
                        Content="⚙ Settings"
                        Command="{Binding OpenSettingsCommand}"
                        Margin="0,0,6,0"/>

                <Button Grid.Column="4"
                        Style="{StaticResource CancelBtn}"
                        Content="✕ Cancel"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding IsIdle, Converter={StaticResource InverseBoolToVis}}"/>
            </Grid>

            <!-- Progress bars -->
            <ProgressBar Grid.Row="1"
                         IsIndeterminate="True" Height="3"
                         Foreground="#CBA6F7" Background="#313244" BorderThickness="0"
                         Margin="0,6,0,0"
                         Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"/>

            <ProgressBar Grid.Row="1"
                         IsIndeterminate="True" Height="3"
                         Foreground="#89DCEB" Background="#313244" BorderThickness="0"
                         Margin="0,6,0,0"
                         Visibility="{Binding IsLoadingDetail, Converter={StaticResource BoolToVis}}"/>

            <ProgressBar Grid.Row="1"
                         IsIndeterminate="True" Height="3"
                         Foreground="#A6E3A1" Background="#313244" BorderThickness="0"
                         Margin="0,6,0,0"
                         Visibility="{Binding IsSaving, Converter={StaticResource BoolToVis}}"/>

            <!-- Status text -->
            <TextBlock Grid.Row="2"
                       Text="{Binding StatusText}"
                       Foreground="#A6ADC8" FontSize="12"
                       Margin="0,4,0,0"/>
        </Grid>

        <!-- ══ Main Content ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="240"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: Search Results List ─────────────────────────────── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0"
                           Foreground="#A6ADC8" FontSize="11" FontWeight="SemiBold"
                           Margin="0,0,0,6">
                    <Run Text="KẾT QUẢ TÌM KIẾM"/>
                    <Run Text=" ("/><Run Text="{Binding SearchResults.Count, Mode=OneWay}"/><Run Text=")"/>
                </TextBlock>

                <!-- No results placeholder -->
                <TextBlock Grid.Row="1"
                           Text="Chưa có kết quả."
                           Foreground="#585B70" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding NoSearchResults, Converter={StaticResource BoolToVis}}"/>

                <!-- Results list -->
                <ListBox Grid.Row="1"
                         Style="{StaticResource ResultListBoxStyle}"
                         ItemTemplate="{StaticResource SearchItemTemplate}"
                         ItemsSource="{Binding SearchResults}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                </ListBox>
            </Grid>

            <!-- ── Splitter ───────────────────────────────────────────────── -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          Background="#45475A"
                          Cursor="SizeWE"/>

            <!-- ── Right: Metadata Detail ─────────────────────────────────── -->
            <Grid Grid.Column="2">

                <!-- Placeholder khi chưa chọn -->
                <TextBlock Text="← Chọn 1 kết quả để xem metadata đầy đủ"
                           Foreground="#585B70" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMetadata}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Loading indicator -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsLoadingDetail, Converter={StaticResource BoolToVis}}">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                                 Foreground="#89DCEB" Background="#313244" BorderThickness="0"/>
                    <TextBlock Text="Đang tải metadata..."
                               Foreground="#A6ADC8" FontSize="13"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Metadata panel -->
                <Border Background="#313244" CornerRadius="10" Padding="16"
                        Visibility="{Binding HasMetadata, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Metadata fields row -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Cover -->
                            <Border Grid.Column="0" CornerRadius="8" ClipToBounds="True"
                                    Margin="0,0,14,0" VerticalAlignment="Top" MaxHeight="240">
                                <Image Stretch="UniformToFill">
                                    <Image.Source>
                                        <PriorityBinding>
                                            <Binding Path="CoverImageSource" IsAsync="False"/>
                                            <Binding Path="Metadata.CoverUrl"/>
                                        </PriorityBinding>
                                    </Image.Source>
                                </Image>
                            </Border>

                            <!-- Fields -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" MaxHeight="260">
                                <StackPanel>
                                    <TextBlock Text="{Binding Metadata.Title}"
                                               Foreground="#CBA6F7" FontSize="19" FontWeight="Bold"
                                               TextWrapping="Wrap" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding Metadata.AlternativeTitle}"
                                               Foreground="#A6ADC8" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Background="#45475A" CornerRadius="4" Padding="8,3">
                                            <TextBlock Foreground="#89DCEB" FontSize="11">
                                                <Run Text="Source: "/>
                                                <Run Text="{Binding Metadata.Source, Mode=OneWay}" FontWeight="Bold"/>
                                            </TextBlock>
                                        </Border>
                                        <Border Background="#45475A" CornerRadius="4" Padding="8,3" Margin="6,0,0,0">
                                            <TextBlock Foreground="#A6E3A1" FontSize="11">
                                                <Run Text="{Binding Metadata.Status, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="AUTHOR" Style="{StaticResource FieldLabel}"/>
                                            <TextBlock Text="{Binding Metadata.Author}" Style="{StaticResource FieldValue}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="ARTIST" Style="{StaticResource FieldLabel}"/>
                                            <TextBlock Text="{Binding Metadata.Artist}" Style="{StaticResource FieldValue}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="GENRES" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding GenresDisplay}" Foreground="#CDD6F4" FontSize="13"
                                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <TextBlock Text="DESCRIPTION" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding Metadata.Description}" Foreground="#CDD6F4" FontSize="13"
                                               TextWrapping="Wrap" Margin="0,0,0,10"
                                               MaxHeight="120" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="DETAIL URL" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock FontSize="12" TextWrapping="Wrap" Cursor="Hand"
                                               TextDecorations="Underline" Foreground="#89B4FA">
                                        <Hyperlink NavigateUri="{Binding Metadata.DetailUrl, Mode=OneWay}"
                                                   RequestNavigate="Hyperlink_RequestNavigate">
                                            <Run Text="{Binding Metadata.DetailUrl, Mode=OneWay}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- Divider + searching indicator -->
                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <Border Height="1" Background="#45475A"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                        Visibility="{Binding IsSearchingImages, Converter={StaticResource BoolToVis}}">
                                <ProgressBar IsIndeterminate="True" Width="120" Height="3"
                                             Foreground="#F4A261" Background="#313244" BorderThickness="0"
                                             VerticalAlignment="Center"/>
                                <TextBlock Text="  Dang tim anh..."
                                           Foreground="#A6ADC8" FontSize="11"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Image Search Results -->
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Cover section -->
                                <StackPanel Grid.Row="0"
                                            Visibility="{Binding CoverResults.Count, Converter={StaticResource CountToVis}}">
                                    <TextBlock Text="COVER (MangaDex / AniList)" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                  ScrollChanged="CoverScrollViewer_ScrollChanged">
                                        <ListBox ItemsSource="{Binding CoverResults}"
                                                 SelectedItem="{Binding SelectedCover, Mode=TwoWay}"
                                                 Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.Template>
                                                <ControlTemplate TargetType="ListBox">
                                                    <ItemsPresenter/>
                                                </ControlTemplate>
                                            </ListBox.Template>
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="SelectionBorder"
                                                                        BorderBrush="Transparent"
                                                                        BorderThickness="2"
                                                                        CornerRadius="8"
                                                                        Padding="2">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#CBA6F7"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#585B70"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="100" Cursor="Hand" ToolTip="{Binding Label}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="140"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Border Grid.Row="0" CornerRadius="6" ClipToBounds="True"
                                                                Background="#1E1E2E">
                                                            <Grid>
                                                                <TextBlock Text="..." Foreground="#585B70"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Visibility="{Binding IsLoadingThumb, Converter={StaticResource BoolToVis}}"/>
                                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                                       Visibility="{Binding IsLoadingThumb, Converter={StaticResource InverseBoolToVis}}"/>
                                                            </Grid>
                                                        </Border>
                                                        <Border Grid.Row="1" Background="{Binding SourceColor}"
                                                                CornerRadius="3" Padding="4,2" Margin="0,4,0,0"
                                                                HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Source}" Foreground="#1E1E2E"
                                                                       FontSize="9" FontWeight="Bold"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </ScrollViewer>
                                </StackPanel>

                                <!-- Banner section -->
                                <StackPanel Grid.Row="1" Margin="0,12,0,0"
                                            Visibility="{Binding BannerResults.Count, Converter={StaticResource CountToVis}}">
                                    <TextBlock Text="BANNER (AniList)" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <ListBox ItemsSource="{Binding BannerResults}"
                                                 SelectedItem="{Binding SelectedBanner, Mode=TwoWay}"
                                                 Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.Template>
                                                <ControlTemplate TargetType="ListBox">
                                                    <ItemsPresenter/>
                                                </ControlTemplate>
                                            </ListBox.Template>
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="SelectionBorder"
                                                                        BorderBrush="Transparent"
                                                                        BorderThickness="2"
                                                                        CornerRadius="8"
                                                                        Padding="2">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#02A9FF"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#585B70"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="240" Cursor="Hand" ToolTip="{Binding Label}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="80"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Border Grid.Row="0" CornerRadius="6" ClipToBounds="True"
                                                                Background="#1E1E2E">
                                                            <Grid>
                                                                <TextBlock Text="..." Foreground="#585B70"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Visibility="{Binding IsLoadingThumb, Converter={StaticResource BoolToVis}}"/>
                                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                                       Visibility="{Binding IsLoadingThumb, Converter={StaticResource InverseBoolToVis}}"/>
                                                            </Grid>
                                                        </Border>
                                                        <Border Grid.Row="1" Background="{Binding SourceColor}"
                                                                CornerRadius="3" Padding="4,2" Margin="0,4,0,0"
                                                                HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Source}" Foreground="#1E1E2E"
                                                                       FontSize="9" FontWeight="Bold"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </ScrollViewer>
                                </StackPanel>
                                <!-- Selected cover display -->
                                <StackPanel Grid.Row="2" Margin="0,10,0,0"
                                            Visibility="{Binding SelectedCover, Converter={StaticResource NullToVis}}">
                                    <TextBlock Text="DA CHON COVER" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding SelectedCover.Url}" Foreground="#A6E3A1"
                                               FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               MaxHeight="32"/>
                                </StackPanel>

                            </Grid>
                        </Grid>

                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

